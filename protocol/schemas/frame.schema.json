{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://sophia-labs.dev/schemas/vehicle-ride/v2/frame.json",
	"title": "A ride v2 response frame",
	"type": "object",
	"required": ["protocol", "type"],
	"properties": {
		"protocol": { "const": "sophia.vehicle-ride.v2" },
		"type": { "type": "string", "minLength": 1 },
		"requestId": { "type": "string" },
		"replayed": { "const": true },
		"value": {},
		"code": { "type": "string" },
		"message": { "type": "string" },
		"details": { "type": "object" }
	},
	"if": { "properties": { "type": { "const": "error" } } },
	"then": { "required": ["code", "message"], "not": { "required": ["value"] } },
	"else": { "required": ["value"] }
}
